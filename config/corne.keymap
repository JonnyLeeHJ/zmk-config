#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
        behaviors {
                alt_caps: alt_caps {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "tap-preferred";
                        tapping-term-ms = <200>;
                        bindings = <&kp>, <&caps_word>;
                };

                tab_ctrl: tab_ctrl {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "tap-preferred";
                        tapping-term-ms = <200>;
                        bindings = <&kp>, <&kp>;
                };
        };

        conditional_layers {
                compatible = "zmk,conditional-layers";
                adjust_layer {
                        if-layers = <1 2>;
                        then-layer = <3>;
                };
        };

        // CW/AL: tap Caps Word, hold 200 ms for Right Alt / Option.
        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        label = "Base";
// -----------------------------------------------------------------------------------------
// | ESC |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  | GUI |
// |  `  |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  |CW/AL|
// |C/TAB|  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  | RSE |
//                   | LWR | SFT | BSPC|   | ENT | SPC |  '  |
                        bindings = <
   &kp ESC   &kp Q &kp W &kp E &kp R &kp T          &kp Y       &kp U &kp I &kp O &kp P    &kp LGUI
   &kp GRAVE &kp A &kp S &kp D &kp F &kp G          &kp H       &kp J &kp K &kp L &kp SEMI &alt_caps RALT 0
   &tab_ctrl LCTRL TAB &kp Z &kp X &kp C &kp V &kp B          &kp N       &kp M &kp COMMA &kp DOT &kp FSLH &mo 2
                    &mo 1 &kp LSHFT &kp BSPC        &kp RET &kp SPACE &kp SQT
                        >;
                };

                lower_layer {
                        label = "Lower";
// -----------------------------------------------------------------------------------------
// |     |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  |     |
// |     |  `  |  ~  |  _  |  \  |  |  |   |     |  (  |  )  |  {  |  }  |     |
// |     |     |     |     |     |     |   |     |  [  |  ]  |     |     |     |
//                   |     |     | DEL |   |     |     |     |
                        bindings = <
   &trans &kp EXCL  &kp AT    &kp HASH  &kp DLLR &kp PRCNT       &kp CARET &kp AMPS &kp STAR &kp LPAR &kp RPAR &trans
   &trans &kp GRAVE &kp TILDE &kp UNDER &kp BSLH &kp PIPE        &trans    &kp LPAR &kp RPAR &kp LBRC &kp RBRC &trans
   &trans &trans    &trans    &trans    &trans   &trans          &trans    &kp LBKT &kp RBKT &trans   &trans   &trans
                              &trans &trans &kp DEL              &trans &trans &trans
                        >;
                };

                raise_layer {
                        label = "Raise";
// -----------------------------------------------------------------------------------------
// |     |  7  |  8  |  9  |  /  |  *  |   |     |     | UP  |     | VOL+|     |
// |     |  4  |  5  |  6  |  -  |  +  |   |     | LFT | DWN | RGT | VOL-|     |
// |     |  1  |  2  |  3  |  0  |  =  |   |     | PREV| PLAY| NEXT| MUTE|     |
//                   |     |     |     |   |     |     |     |
                        bindings = <
   &trans &kp N7 &kp N8 &kp N9 &kp FSLH  &kp STAR       &trans &trans     &kp UP   &trans     &kp C_VOL_UP &trans
   &trans &kp N4 &kp N5 &kp N6 &kp MINUS &kp PLUS       &trans &kp LEFT   &kp DOWN &kp RIGHT  &kp C_VOL_DN &trans
   &trans &kp N1 &kp N2 &kp N3 &kp N0    &kp EQUAL      &trans &kp C_PREV &kp C_PP &kp C_NEXT &kp C_MUTE   &trans
                        &trans &trans &trans            &trans &trans &trans
                        >;
                };

                adjust_layer {
                        label = "Adjust";
// -----------------------------------------------------------------------------------------
// |     | F1  | F2  | F3  | F4  | F5  |   | F6  | F7  | F8  | F9  | F10 |     |
// |     | F11 | F12 | CAPS| INS |PSCRN|   | HOME| PGUP| PGDN| END | BOOT|     |
// |     | USB | BLE |BTCLR| BOOT|RESET|   | BT1 | BT2 | BT3 | BT4 | BT5 |     |
//                   |     |     |     |   |     |     |     |
                        bindings = <
   &trans &kp F1       &kp F2       &kp F3     &kp F4       &kp F5           &kp F6       &kp F7       &kp F8       &kp F9       &kp F10      &trans
   &trans &kp F11      &kp F12      &kp CAPS   &kp INS      &kp PSCRN        &kp HOME     &kp PG_UP    &kp PG_DN    &kp END      &bootloader  &trans
   &trans &out OUT_USB &out OUT_BLE &bt BT_CLR &bootloader  &sys_reset       &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans
                                    &trans &trans &trans                     &trans &trans &trans
                        >;
                };
        };
};
